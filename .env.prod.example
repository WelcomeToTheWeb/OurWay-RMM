# OurWay RMM production environment (A-1).
#
#   cp .env.prod.example .env.prod
#   # fill in the REQUIRED secrets below, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#   # (or: make prod)
#
# .env.prod is git-ignored — it holds real secrets.

# ---- public identity -------------------------------------------------------
# The operator's public URL. Used by the Add Device UI to prefill the server
# URL field so agents enroll to the correct target, and seeded into the mTLS
# server cert's SANs so remote agents' x509 hostname verification passes.
# Agents dial the host portion of this URL on port 50052 (OURWAY_RMM_AGENT_MTLS_PORT).
#
# When behind a reverse proxy (Caddy on 443, your own proxy, etc.), set this
# to the PUBLIC URL that external agents can reach, e.g.:
#   OURWAY_RMM_PUBLIC_URL=https://rmm.example.com
#
# If unset, the Add Device UI falls back to the browser's window.location.origin
# and the mTLS cert SANs are derived from the bind addresses + OURWAY_RMM_GRPC_MTLS_SANs.
OURWAY_RMM_PUBLIC_URL=https://rmm.example.com

# Legacy: only honored for the bundled Caddy's site name (inactive in the
# BYO-proxy stack). It does NOT affect the mTLS cert — set OURWAY_RMM_PUBLIC_URL
# and/or OURWAY_RMM_GRPC_MTLS_SANs instead.
OURWAY_RMM_DOMAIN=localhost

# Optional: extra SANs for the mTLS server cert (comma-separated DNS names /
# IPs), added on top of the public URL host + bind addresses. Set it when
# your agents dial an address different from OURWAY_RMM_PUBLIC_URL — e.g. the
# host's LAN IP:
# OURWAY_RMM_GRPC_MTLS_SANs=203.0.113.10

# Let's Encrypt account email (expiry notices only). Optional.
OURWAY_RMM_ACME_EMAIL=admin@example.com

# The ONLY host port agents need (besides the operator origin on 443/80).
# Agents enroll over the operator's HTTPS origin (POST /agent/enroll) and then
# stream over this mTLS gRPC port. The plain gRPC bootstrap port (50051) stays
# internal — a remote device only needs the server host + this port open.
OURWAY_RMM_AGENT_MTLS_PORT=50052

# ---- REQUIRED secrets (generate each with: openssl rand -hex 32) -----------
# Signs operator JWTs + capability tokens.
OURWAY_RMM_JWT_SECRET=

# Postgres/Timescale superuser password for this stack.
OURWAY_RMM_PG_PASSWORD=

# Meilisearch master key.
OURWAY_RMM_MEILI_MASTER_KEY=

# MinIO root password.
OURWAY_RMM_MINIO_PASSWORD=

# Env fallback / break-glass operator admin (A-2). The PRIMARY root admin is
# minted by the first-boot setup wizard (see README "First-boot setup wizard");
# this env account stays as a known, strong out-of-band login. Set it to a
# strong secret distinct from the wizard password.
OURWAY_RMM_ADMIN_PASSWORD=

# ---- optional overrides ------------------------------------------------------
# Boot-time env (C2): "dev" allows the built-in dev defaults; any other value
# makes the server refuse to boot while a default JWT secret / admin creds /
# Meili master key is in play. Set it explicitly so prod is prod on purpose.
OURWAY_RMM_ENV=prod

# Image tag stamped into the built server/frontend images.
OURWAY_RMM_VERSION=1.5.0

# Postgres user (default ourway-rmm), admin login (default admin), MinIO user
# (default ourway-rmm).
OURWAY_RMM_PG_USER=ourway-rmm
OURWAY_RMM_ADMIN_USER=admin
OURWAY_RMM_MINIO_USER=ourway-rmm

# Bring-your-own reverse proxy (A-1). Only used by the BYO flow
# (`make prod-byoproxy`, i.e. the base file + docker-compose.byoproxy.yml with
# the bundled Caddy "edge" profile off). They set the HOST ports your proxy
# forwards to. SIMPLEST: point your whole proxy at the SPA port — the frontend
# serves the SPA and proxies /api, /agent and /healthz to the backend:
#   everything                  ->  localhost:OURWAY_RMM_FRONTEND_PORT
# OPTIONAL: route /api straight to the backend instead (skip the frontend hop):
#   /api/*  /agent/*  /healthz* ->  localhost:OURWAY_RMM_HTTP_PORT
# Leave unset to use the defaults (8080 / 8081).
OURWAY_RMM_HTTP_PORT=8080
OURWAY_RMM_FRONTEND_PORT=8081
